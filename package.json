{
	"name": "can-merge",
	"version": "0.2.0",
	"description": "",
	"bin": {
		"can-merge": "./bin/can-merge.mjs"
	},
	"main": false,
	"exports": {
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepack": "npmignore --auto --commentLines=autogenerated",
		"prepublishOnly": "safe-publish-latest",
		"prepublish": "not-in-publish || npm run prepublishOnly",
		"lint": "eslint .",
		"pretest": "npm run lint",
		"tests-only": "c8 tape 'test/**/*.mjs' | tap-spec",
		"test": "npm run tests-only",
		"posttest": "npx npm@\">= 10.2\" audit --production",
		"generate-readme": "md-magic --files README.md",
		"generate-readme:check": "npm run generate-readme && git diff --exit-code README.md",
		"version": "auto-changelog && git add CHANGELOG.md",
		"postversion": "auto-changelog && git add CHANGELOG.md && git commit --no-edit --amend && git tag -f \"v$(node -e \"console.log(require('./package.json').version)\")\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ljharb/can-merge.git"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ljharb/can-merge/issues"
	},
	"homepage": "https://github.com/ljharb/can-merge#readme",
	"devDependencies": {
		"@ljharb/eslint-config": "^22.2.3",
		"auto-changelog": "^2.6.0",
		"c8": "^11.0.0",
		"eslint": "^10.5.0",
		"in-publish": "^2.0.1",
		"jiti": "^0.0.0",
		"markdown-magic": "^4.9.0",
		"npmignore": "^0.3.5",
		"object.fromentries": "^2.0.8",
		"safe-publish-latest": "^2.0.0",
		"tap-spec": "^5.0.0",
		"tape": "^5.10.2"
	},
	"dependencies": {
		"@octokit/graphql": "^9.0.3",
		"git-repo-info": "^2.1.1",
		"pargs": "^1.4.2",
		"parse-git-config": "^3.0.0"
	},
	"engines": {
		"node": "^22.22 || ^24.14 || >= 25.8.1"
	},
	"publishConfig": {
		"ignore": [
			".editorconfig",
			"eslint.config.mjs",
			".gitattributes",
			".github/workflows",
			".github/*.gif",
			"CONTRIBUTING.md",
			"md.config.js",
			"test/"
		]
	},
	"auto-changelog": {
		"output": "CHANGELOG.md",
		"template": "keepachangelog",
		"unreleased": false,
		"commitLimit": false,
		"backfillLimit": false,
		"hideCredit": true
	}
}
